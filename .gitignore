# ============================================================================
# The Accessories Hub — .gitignore
# ============================================================================

# Environment variables & secrets (CRITICAL)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
credentials.json
service-account*.json
*.sqlite
*.db

# Operating System files
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# IDE & Editor artifacts
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Local temporary and office documents
*.docx
*.xlsx
*.csv.tmp
"Rescued document.docx"

# Dependencies & Build artifacts
node_modules/
dist/
build/
.vercel/
skills-lock.json

# Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
